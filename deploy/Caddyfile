# Tambahkan blok ini ke Caddyfile di server Hetzner, lalu: caddy reload
# DNS: A record lembar.erwarx.com → IP server. Caddy urus HTTPS otomatis (wajib untuk PWA).
lembar.erwarx.com {
	root * /var/www/lembar
	encode zstd gzip
	file_server

	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Service worker & halaman utama harus selalu dicek ulang supaya update cepat sampai
	@fresh path /sw.js / /index.html /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	@static path /vendor/* /icons/*
	header @static Cache-Control "public, max-age=2592000"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
