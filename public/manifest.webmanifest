{
  "id": "./",
  "name": "Lembar — Pembaca PDF",
  "short_name": "Lembar",
  "description": "Pembaca PDF ringan: zoom, cari teks, bookmark, mode malam.",
  "lang": "id",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#EDF0EC",
  "theme_color": "#1F6F5C",
  "categories": ["books", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "pdf", "accept": ["application/pdf", ".pdf"] }
      ]
    }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ],
  "launch_handler": { "client_mode": "navigate-existing" }
}
